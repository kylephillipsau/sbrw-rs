        "body": "{\"activatedHolidaySceneryGroups\":[\"SCENERY_GROUP_NORMAL\"],\"adminList\":\"???\",\"country\":\"US\",\"disactivatedHolidaySceneryGroups\":[\"SCENERY_GROUP_NORMAL_DISABLE\"],\"numberOfRegistered\":0,\"onlineNumber\":0,\"ownerList\":\"???\",\"requireTicket\":false,\"secondsToShutDown\":9999999,\"serverName\":\"Before\",\"serverVersion\":\"unknown\",\"timezone\":0}"
      }
    },
    {
      "note": "The wrong token reloads nothing.",
      "request": {
        "method": "POST",
        "path": "/Engine.svc/ReloadParameters",
        "query": null,
        "headers": null,
        "form": {
          "message": "x",
          "adminAuth": "wrong"
        },
        "body": null,
        "content_type": null,
        "remote_addr": null
