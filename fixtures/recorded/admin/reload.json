{
  "scenario": "admin/reload",
  "description": "Reloading parameters and login announcements with the admin token, and both refusing once the token is gone.",
  "upstream": "SoapboxRaceWorld/soapbox-race-core@d3edcd002514eb5265ad44484d79c4d2541ab055",
  "boot": {
    "openfire": [
      {
        "call": "init",
        "args": []
      },
      {
        "call": "getTotalOnlineUsers",
        "args": []
      }
    ]
  },
  "steps": [
    {
      "note": "The server's name.",
      "request": {
        "method": "GET",
        "path": "/Engine.svc/GetServerInformation",
        "query": null,
        "headers": null,
        "form": null,
        "body": null,
        "content_type": null,
        "remote_addr": null
      },
      "response": {
        "status": 200,
        "headers": {
          "Connection": "close",
          "Content-Type": "application/json"
