      "response": {
        "status": 200,
        "headers": {
          "Connection": "close",
          "Content-Type": "text/html;charset=UTF-8"
        },
        "body": "ERROR! invalid admin token"
      }
    },
    {
      "note": "The admin token reloads them.",
      "request": {
        "method": "POST",
        "path": "/Engine.svc/ReloadParameters",
        "query": null,
        "headers": null,
        "form": {
          "adminAuth": "InsertAdminAuthHere"
        },
        "body": null,
        "content_type": null,
        "remote_addr": null
      },
      "response": {
        "status": 200,
        "headers": {
          "Connection": "close",
          "Content-Type": "text/html;charset=UTF-8"
        },
        "body": "SUCCESS! reloaded parameters"
      }
