        "headers": { "X-HWID": "HWID-1" }
      }
    },
    {
      "note": "An empty PORTAL_DOMAIN means the default.",
      "http": {
        "method": "GET",
        "path": "/Engine.svc/systeminfo",
        "headers": { "userId": "1", "securityToken": "00000000-0000-4000-8000-000000000001" }
      }
    },
    {
      "note": "Permanent session ...0002.",
      "http": {
        "method": "POST",
        "path": "/Engine.svc/User/GetPermanentSession",
        "headers": { "userId": "1", "securityToken": "00000000-0000-4000-8000-000000000001" }
      }
    },
    {
      "note": "Only known scenery groups are listed, but every enabled one gets an id (0 when unknown).",
      "http": {
        "method": "GET",
        "path": "/Engine.svc/getusersettings",
        "headers": { "userId": "1", "securityToken": "00000000-0000-4000-8000-000000000002" }
      }
